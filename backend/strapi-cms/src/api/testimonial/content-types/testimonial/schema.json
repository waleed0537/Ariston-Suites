{
  "kind": "collectionType",
  "collectionName": "testimonials",
  "info": {
    "singularName": "testimonial",
    "pluralName": "testimonials",
    "displayName": "testimonials"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "location": {
      "type": "string",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "content": {
      "type": "text",
      "required": true
    },
    "roomType": {
      "type": "string",
      "required": true
    },
    "stayDuration": {
      "type": "string",
      "required": true
    },
    "videoUrl": {
      "type": "string"
    },
    "rating": {
      "type": "integer",
      "required": true,
      "default": 5,
      "min": 1,
      "max": 5
    },
    "helpful": {
      "type": "integer",
      "default": 0
    },
    "verified": {
      "type": "boolean",
      "default": true
    },
    "date": {
      "type": "date",
      "required": true
    },
    "guestImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "reviewImages": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "Standard Suite",
        "Deluxe Suite",
        "King Deluxe Suite",
        "Twin Deluxe Suite"
      ]
    }
  }
}
